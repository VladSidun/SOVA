# Blank for preview. Set the actual HTTPS origin (no path/query) before launch.
NEXT_PUBLIC_SITE_URL=
# Explicit launch gate; preview remains noindex even when a domain is configured.
SOVA_INDEXABLE=false

# Optional comma-separated hostnames/IPs allowed to load Next.js dev resources
# when previewing from another device on your local network (no scheme or port).
SOVA_ALLOWED_DEV_ORIGINS=

# Server-only. Required by POST /api/leads. Never expose or commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TURNSTILE_SECRET_KEY=

# Public Turnstile widget identifier. Configure together with the server secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Adapters only; flags + ID + separate tracking consent + audited SDK required.
NEXT_PUBLIC_ENABLE_GA=false
NEXT_PUBLIC_ENABLE_META_PIXEL=false
NEXT_PUBLIC_ENABLE_TIKTOK_PIXEL=false

# Optional verified public contact links. WhatsApp and Viber otherwise use the
# confirmed business phone; Telegram is shown only when this public URL is set.
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_VIBER_URL=
NEXT_PUBLIC_TELEGRAM_URL=
