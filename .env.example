# Local development only. Replace with the actual HTTPS URL before production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Required by POST /api/leads. Never expose or commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TURNSTILE_SECRET_KEY=

# Public Turnstile widget identifier. Configure together with the server secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Optional verified public contact links. WhatsApp and Viber otherwise use the
# confirmed business phone; Telegram is shown only when this public URL is set.
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_VIBER_URL=
NEXT_PUBLIC_TELEGRAM_URL=
